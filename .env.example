# ============================================================================
# UniCenter — 生产环境变量模板
#
# 用法：cp .env.example .env 后逐项修改；.env 会被 docker compose 自动读取
# （优先级高于 compose 文件内默认值，低于 shell 已导出的同名环境变量）。
#
# ⚠️ 安全约定：
#   - .env 已在 .gitignore 中排除，严禁提交仓库；
#   - 生产口令/密钥建议经 CI 密钥库或 k8s Secret 注入，而非明文落盘；
#   - 下方标 [必须] 的项未设置时 docker compose up 会直接失败（缺省值缺失）。
#
# 变量命名遵循 uni_core/configs 的 viper 映射：配置键点号 → 下划线，
#   database.password  → DATABASE_PASSWORD
#   server.trustedProxies → SERVER_TRUSTEDPROXIES
# ============================================================================

# ────────────────────────────────────────────────────────────────
# 镜像与版本
# ────────────────────────────────────────────────────────────────
# 镜像仓库前缀 + tag（push 到私有 registry 后由该名称原子拉起，避免现场构建）
SERVER_IMAGE=tangwy-t/uni_core
SERVER_IMAGE_TAG=latest
WEB_IMAGE=tangwy-t/uni_console
WEB_IMAGE_TAG=latest

# 版本信息注入（后端监控页「构建时间/提交 Hash」；留空走 Dockerfile 兜底）
# 推荐：CI 中 export VERSION="$(git describe --tags --always)" 等
# VERSION=
# BUILD_TIME=
# COMMIT_HASH=

# ────────────────────────────────────────────────────────────────
# 时区
# ────────────────────────────────────────────────────────────────
TZ=Asia/Shanghai

# ────────────────────────────────────────────────────────────────
# 关系数据库（MySQL / PostgreSQL，外部生产实例，DBA 提供）
#   DATABASE_DRIVER=postgres 时，DATABASE_PORT 建议 5432，
#   DATABASE_CHARSET 被忽略，DATABASE_SSLMODE 生效。
# ────────────────────────────────────────────────────────────────
DATABASE_DRIVER=mysql                     # mysql | postgres
DATABASE_HOST=host.docker.internal        # 或用内网 IP / RDS 域名
DATABASE_PORT=3306                        # MySQL 3306 / PostgreSQL 5432
DATABASE_USER=wmf_app                     # [必须] 生产禁用 root，使用最小权限账号
DATABASE_PASSWORD=change-me-strong-password  # [必须] 改！至少 16 位，含大小写/数字/符号
DATABASE_DBNAME=web_manager_framework
DATABASE_CHARSET=utf8mb4
DATABASE_SSLMODE=disable                  # 仅 postgres 使用: disable|require|verify-ca|verify-full
DATABASE_SCHEMA=                          # 仅 postgres：目标 schema/search_path（默认 public，可逗号分隔）

# 连接池（按 RDS 规格调优）
DATABASE_MAXIDLECONNS=10
DATABASE_MAXOPENCONNS=100
DATABASE_MAXLIFETIME=3600

# 慢查询（毫秒）与统计日志
DATABASE_SLOWQUERYTHRESHOLD=200
DATABASE_SLOWQUERYLOGENABLED=true

# ────────────────────────────────────────────────────────────────
# Redis（外部生产实例 / 云 Redis）
# ────────────────────────────────────────────────────────────────
REDIS_MODE=single                         # single | cluster | sentinel
REDIS_ADDR=host.docker.internal:6379
REDIS_PASSWORD=                           # 无密码留空（viper 忽略空值）
REDIS_DB=0
REDIS_DIALTIMEOUT=5000
REDIS_READTIMEOUT=3000
REDIS_WRITETIMEOUT=3000

# 集群/哨兵模式（mode=cluster/sentinel 时启用；compose 单实例默认不填）
# REDIS_ADDRS=r1:6379,r2:6379,r3:6379
# REDIS_MASTERNAME=mymaster

# ────────────────────────────────────────────────────────────────
# 后端服务（uni_core）
# ────────────────────────────────────────────────────────────────
# ⚠️ 生产由 nginx 反代，后端只 expose 内部端口，不直连宿主机——
#    SERVER_PORT 此处仅约定容器内监听端口，如需直连调试卷端口见 compose ports。
SERVER_PORT=8088
SERVER_MODE=release                       # 生产强制 release（关闭 swagger/pprof）
SERVER_READTIMEOUT=30
SERVER_WRITETIMEOUT=60
SERVER_IDLETIMEOUT=60
SERVER_MAXHEADERBYTES=1048576
SERVER_DRAINTIMEOUT=25
SERVER_CLEANUPTIMEOUT=5

# ⚠️ 关键安全项：受信任反向代理网段（CIDR，多个用逗号分隔）。
# 部署在 nginx/SLB 之后必须配置，否则按 IP 的登录限流可被 X-Forwarded-For 伪造绕过。
# 取值 = 你前端 nginx 容器所在网络。单机默认 bridge 常见为 172.16.0.0/12：
# SERVER_TRUSTEDPROXIES=172.16.0.0/12,10.0.0.0/8
# 若不接反代、直连后端则保持留空【默认 = 不信任任何代理，更安全】。
SERVER_TRUSTEDPROXIES=

# ────────────────────────────────────────────────────────────────
# 日志（生产推荐 JSON 输出，供日志采集/告警）
# ────────────────────────────────────────────────────────────────
LOG_LEVEL=info                            # debug | info | warn | error
LOG_FORMAT=json                           # json(生产推荐) | console
LOG_CALLER=true
# LOG_DEVELOPMENT 固定 false，已由 compose 锁定，无需在此设置

# 容器日志滚动（docker json-file driver）
LOG_MAX_SIZE=50m
LOG_MAX_FILE=5

# ────────────────────────────────────────────────────────────────
# 可观测性（OpenTelemetry，默认关闭）
# ────────────────────────────────────────────────────────────────
# 说明：uni_core 用 OTLP gRPC(Insecure)出站上报，endpoint 为「裸 host:port」，
#       禁止带 http:// scheme（详见 uni_core/internal/pkg/tracing/tracer.go）。
# 开启并接入本 compose 自带追踪（Jaeger v2，--profile tracing）时：
#   OBSERVABILITY_TRACING_ENABLED=true
#   OBSERVABILITY_TRACING_ENDPOINT=jaeger:4317
# 接入外部云 APM / 自建 Collector 时填对应 host:4317。
OBSERVABILITY_TRACING_ENABLED=false
OBSERVABILITY_TRACING_ENDPOINT=           # 例 jaeger:4317
OBSERVABILITY_TRACING_SAMPLERATE=0.1

# 追踪 Jaeger v2 查询 UI 对外端口（仅 --profile tracing 启动时生效，内网查看用）
JAEGER_UI_PORT=16686

# ────────────────────────────────────────────────────────────────
# 文件对象存储后端（S3 兼容：MinIO / AWS S3 / 阿里云 OSS / 腾讯云 COS）
# 默认 local（本地盘 data/uploads）。切换 s3 时需同时填 S3 凭据。
# 对应 uni_core/configs 的 viper 映射：storage.backend → STORAGE_BACKEND（点号→下划线）。
# 注意：这些变量需由 compose 的 `environment:`/`env_file` 透传给 uni_core 容器；
#       也可直接改 uni_core/configs/config.yaml（推荐，随镜像打包）。
# ────────────────────────────────────────────────────────────────
# STORAGE_BACKEND=local
# STORAGE_S3_ENDPOINT=localhost:9000
# STORAGE_S3_ACCESSKEY=
# STORAGE_S3_SECRETKEY=
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_USESSL=false
# STORAGE_S3_PATHSTYLE=true

# ────────────────────────────────────────────────────────────────
# 资源限制与安全（按真实负载调优）
# ────────────────────────────────────────────────────────────────
SERVER_MEM_LIMIT=1g
SERVER_CPUS=1.0
WEB_MEM_LIMIT=256m
WEB_CPUS=0.5

# ────────────────────────────────────────────────────────────────
# 端口映射
# ────────────────────────────────────────────────────────────────
# 前端对外唯一入口（nginx）。生产通常在更外层接负载均衡 / TLS 网关。
WEB_PORT=80

# ────────────────────────────────────────────────────────────────
# 构建镜像源（内网无法出公网时改国内镜像；生产默认官方源）
# ────────────────────────────────────────────────────────────────
# GOPROXY=https://proxy.golang.org,direct
# NPM_REGISTRY=https://registry.npmmirror.com

# ────────────────────────────────────────────────────────────────
# 前端（uni_console/Vue3）构建变量 —— 经 compose build.args 透传给 uni_console/Dockerfile，
# 编译期内联进 dist，运行时 nginx 静态托管不再读取。不设时退回 Dockerfile 默认。
# ────────────────────────────────────────────────────────────────
# VITE_API_URL=/                  # API 基础路径（保持 /，nginx 反代 /api）
# VITE_BASE_URL=/                 # 部署基础路径（子目录部署如 /admin/）
# VITE_VERSION=0.1.0              # 应用版本（注入 __APP_VERSION__）
# VITE_API_PREFIX=/api/v1         # API 前缀（后端统一 /api/v1）
# VITE_ACCESS_MODE=backend        # 权限模式 frontend | backend
# VITE_WITH_CREDENTIALS=false     # 跨域是否携带 Cookie
# VITE_OPEN_ROUTE_INFO=false      # 是否打开路由信息
# VITE_DROP_CONSOLE=true          # 生产构建删除 console（务必 true）

# ============================================================================
# 说明：JWT 签名密钥（sys.jwt.secret）由后端启动时自动从数据库 sys_config 读取，
#       缺失则生成随机值并轮换写入；无需、也不应在此注入环境变量。
#       （uni_core/internal/pkg/jwt、service/config.go 自动兜底 + 安全轮换）
# ============================================================================