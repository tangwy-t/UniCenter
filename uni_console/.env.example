# ============================================================
# web-admin 环境变量模板
# 使用方法：复制本文件为 .env / .env.development / .env.production 并按需修改
# (注意：.env / .env.* 已被 .gitignore 忽略，不会提交到仓库)
# ============================================================

# 【通用】环境变量

# 版本号
VITE_VERSION = 0.1.0

# 端口号
VITE_PORT = 3006

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# API 接口前缀（后端统一 /api/v1）
VITE_API_PREFIX = /api/v1

# 权限模式【 frontend 前端模式 / backend 后端模式 】
VITE_ACCESS_MODE = backend

# 跨域请求时是否携带 Cookie
VITE_WITH_CREDENTIALS = false

# 是否打开路由信息
VITE_OPEN_ROUTE_INFO = false

# 【开发】环境变量（.env.development）

# API 请求基础路径（开发环境设置为 / 使用代理）
VITE_API_URL = /

# 代理目标地址（开发环境通过 Vite 代理转发请求到此地址，指向 Go 后端）
VITE_API_PROXY_URL = http://127.0.0.1:9999

# Delete console
VITE_DROP_CONSOLE = false

# 【生产】环境变量（.env.production）

# 注意：不能用 /api/v1 —— API 模块的 url 已自带 VITE_API_PREFIX(/api/v1)，
# baseURL 再带前缀会拼出 /api/v1/api/v1/... 导致 404
VITE_DROP_CONSOLE = true