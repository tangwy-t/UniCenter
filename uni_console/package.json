{
  "name": "web-admin",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=8.8.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "serve": "vite preview",
    "lint": "eslint",
    "fix": "eslint --fix",
    "test": "vitest run",
    "lint:prettier": "prettier --write \"**/*.{js,cjs,ts,json,tsx,vue,html,md}\"",
    "gen:api": "cd ../uni_core && go run ./tools/apigen -out ../uni_console/src/types/api/api.generated.d.ts -permout ../uni_console/src/enums/permission.ts",
    "check:api-types": "cd ../uni_core && go run ./tools/apigen -out ../uni_console/src/types/api/api.generated.d.ts -permout ../uni_console/src/enums/permission.ts && cd ../uni_console && git diff --exit-code -- src/types/api/api.generated.d.ts src/enums/permission.ts && node scripts/check-permissions.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify/vue": "^5.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vueuse/core": "^13.9.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "next",
    "axios": "^1.12.2",
    "cron-parser": "^5.10.0",
    "cronstrue": "^3.24.0",
    "dompurify": "^3.4.15",
    "echarts": "^6.0.0",
    "element-plus": "2.11.4",
    "file-saver": "^2.0.5",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "ohash": "^2.0.11",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.3.0",
    "tailwindcss": "^4.1.14",
    "vue": "3.5.22",
    "vue-draggable-plus": "^0.6.0",
    "vue-router": "^4.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@iconify-json/ri": "^1.2.10",
    "@types/node": "^24.0.5",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/compiler-sfc": "3.5.22",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.27.0",
    "globals": "^15.9.0",
    "prettier": "^3.5.3",
    "sass": "^1.81.0",
    "terser": "^5.36.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.9.0",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-element-plus": "^0.10.0",
    "unplugin-vue-components": "^29.1.0",
    "vite": "^7.1.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-demi": "^0.14.9",
    "vue-tsc": "~2.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "core-js",
      "es5-ext",
      "esbuild",
      "vue-demi"
    ]
  }
}